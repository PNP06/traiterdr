// Traité RDR numérique : `npm run docs:build` (VitePress) produit .vitepress/dist, publié sur Cloudflare.
// Mis en ligne par Workers Builds (Cloudflare) à chaque push sur la branche principale.
// Adresse : https://traiterdr.ddlab.fr (Custom Domain du Worker « traiterdr »).
{
  "name": "traiterdr",
  "account_id": "43ee5bd1b2587f12085fee1f36e4d619",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".vitepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
